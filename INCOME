 IMPORTANT:
 নিচের SUPABASE_ANON_KEY-এ তোমার নিজের ANON/PUBLISHABLE KEY বসাবে।
 SERVICE_ROLE/SECRET KEY এখানে কখনো বসাবে না।
*/

const SUPABASE_URL = "https://vtaojjjaekjijfziocay.supabase.co";
const SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZ0YW9qamphZWtqaWpmemlvY2F5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc4NTcwMDYsImV4cCI6MjEwMzQzMzAwNn0.9C1qpG41Z8tuwgYBO7LZKMP3LCYOzsgFNlhfqMUlues";

const supabase = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_ANON_KEY

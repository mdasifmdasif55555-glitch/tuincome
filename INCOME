function selectMethod(el){
  document.querySelectorAll(".method").forEach(x=>x.classList.remove("selected"));
  el.classList.add("selected");
}

function copyNum(n){
  navigator.clipboard?.writeText(n);
  alert("কপি হয়েছে");
}

function saveProfile(){
  let n=document.getElementById("pname").value.trim();
  let p=document.getElementById("pphone").value.trim();

  if(!n || !/^(01)\d{9}$/.test(p)){
    return alert("সঠিক নাম ও ১১ সংখ্যার মোবাইল নম্বর দিন");
  }

  profile={name:n,phone:p};
  localStorage.setItem("tu_profile",JSON.stringify(profile));

  alert("Profile saved");
  closeSheet();
}

function submit(type){
  let ok;

  if(type==="deposit"){
    ok=
      document.getElementById("depAmount").value &&
      document.getElementById("txn").value.trim();
  }else{
    ok=
      Number(document.getElementById("wdAmount").value)>=500 &&
      /^(01)\d{9}$/.test(
        document.getElementById("wdNumber").value.trim()
      );
  }

  if(!ok){
    return alert(
      type==="deposit"
      ?"Amount ও Transaction ID দিন"
      :"কমপক্ষে ৫০০ টাকা এবং সঠিক নম্বর দিন"
    );
  }

  localStorage.setItem(
    "tu_last_request",
    JSON.stringify({
      type,
      at:new Date().toISOString()
    })
  );

  document.getElementById("success").style.display="block";
}

function closeSheet(){
  document.getElementById("modal").style.display="none";
}


/* =========================
   TASK SYSTEM
========================= */

async function loadTasks(){

  const grid=document.getElementById("taskGrid");

  const {data,error}=await supabase
    .from("tasks")
    .select("id,title,description,reward,active,max_completions")
    .eq("active",true)
    .order("title");

  if(error){
    console.error(error);
    grid.innerHTML=`
      <div class="number">
        <b>Task load করা যায়নি</b>
        <small>${escapeHtml(error.message)}</small>
      </div>`;
    return;
  }

  if(!data || data.length===0){
    grid.innerHTML=`
      <div class="number">
        <b>এখন কোনো active task নেই।</b>
      </div>`;
    return;
  }

  grid.innerHTML=data.map((task,index)=>{

    const icons=["📋","🔔","⭐","📚","💡","🎯","📖","🔎","🚀","📝","🏆","🌟","📣","🎁"];
    const icon=icons[index % icons.length];

    return `
      <div class="task-card card">

        <div class="task-icon">${icon}</div>

        <div class="task-info">
          <b>${escapeHtml(task.title || "Task")}</b>

          <small>
            ${escapeHtml(task.description || "মাত্র ৩ সেকেন্ড")}
          </small>

          <br>

          <button
            class="task-btn"
            data-task-id="${task.id}"
            data-reward="${Number(task.reward || 0)}"
            onclick="startTask(this)">
            শুরু করুন
          </button>
        </div>

        <div class="task-reward">
          ৳${Number(task.reward || 0).toLocaleString()}
        </div>

      </div>`;
  }).join("");

  await markAlreadyCompleted();
}

async function markAlreadyCompleted(){

  const {
    data:{user}
  } = await supabase.auth.getUser();

  if(!user) return;

  const {data,error}=await supabase
    .from("task_completions")
    .select("task_id")
    .eq("user_id",user.id);

  if(error){
    console.error(error);
    return;
  }

  const completed=new Set(
    (data || []).map(x=>x.task_id)
  );

  document.querySelectorAll(".task-btn").forEach(btn=>{
    if(completed.has(btn.dataset.taskId)){
      btn.disabled=true;
      btn.textContent="সম্পন্ন";
    }
  });
}

function startTask(btn){

  if(taskTimer) return;

  const taskId=btn.dataset.taskId;
  const reward=Number(btn.dataset.reward || 0);

  if(!taskId){
    alert("Task ID পাওয়া যায়নি।");
    return;
  }

  currentTask={
    id:taskId,
    reward:reward,
    button:btn
  };

  document.getElementById("taskModal").style.display="flex";
  document.getElementById("taskCountdown").textContent="3";
  document.getElementById("taskProgress").style.width="0%";
  document.getElementById("taskClose").style.display="none";
  document.getElementById("taskTitle").textContent="টাস্ক চলছে";

  let left=3;

  taskTimer=setInterval(()=>{

    left--;

    document.getElementById("taskCountdown").textContent=left;

    document.getElementById("taskProgress").style.width=
      ((3-left)/3*100)+"%";

    if(left<=0){

      clearInterval(taskTimer);
      taskTimer=null;

      document.getElementById("taskCountdown").textContent="✓";
      document.getElementById("taskTitle").textContent="টাস্ক সম্পন্ন";
      document.getElementById("taskClose").style.display="inline-block";
    }

  },1000);
}


async function finishTask(){

  if(!currentTask) return;

  const btn=currentTask.button;
  const taskId=currentTask.id;

  btn.disabled=true;
  btn.textContent="Processing...";

  try{

    const {
      data:{user},
      error:userError
    }=await supabase.auth.getUser();

    if(userError){
      throw userError;
    }

    if(!user){
      btn.disabled=false;
      btn.textContent="শুরু করুন";
      alert("প্রথমে Login/Register করতে হবে।");
      return;
    }

    const {data,error}=await supabase.rpc(
      "complete_task",
      {
        p_task_id:taskId
      }
    );

    if(error){
      console.error(error);

      btn.disabled=false;
      btn.textContent="শুরু করুন";

      alert(error.message);
      return;
    }

    document.getElementById("taskModal").style.display="none";

    btn.disabled=true;
    btn.textContent="সম্পন্ন";

    currentTask=null;

    await loadDatabaseBalance();

    alert(
      data ||
      "Task সম্পন্ন হয়েছে এবং reward যোগ হয়েছে।"
    );

  }catch(err){

    console.error(err);

    btn.disabled=false;
    btn.textContent="শুরু করুন";

    alert("Task complete করতে সমস্যা হয়েছে।");
  }
}


/* =========================
   DATABASE BALANCE
========================= */

async function loadDatabaseBalance(){

  const {
    data:{user}
  }=await supabase.auth.getUser();

  if(!user) return;

  const {data,error}=await supabase
    .from("wallets")

<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TUINCOME v7</title>

<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,"Noto Sans Bengali",sans-serif;background:#f5f7f9;color:#172033;padding-bottom:95px}
header{height:76px;padding:16px 20px;background:linear-gradient(135deg,#ff6500,#ff8b00);color:#fff;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:23px;font-weight:900}
.lang{border:1px solid #fff6;background:#fff2;color:#fff;border-radius:24px;padding:10px 15px}
.hero{background:linear-gradient(135deg,#ff6500,#ff5210);color:#fff;padding:22px 20px 28px;border-radius:0 0 34px 34px}
.small{opacity:.9}
.balance{font-size:42px;font-weight:900;margin:5px 0 18px}
.wallet{width:100%;border:0;border-radius:28px;padding:14px;background:#ffffff26;color:#fff;font-size:16px}
.card{background:#fff;border-radius:24px;box-shadow:0 8px 25px #1422380d}
.quick{margin:16px 10px;padding:15px;display:grid;grid-template-columns:repeat(4,1fr);gap:5px}
.quick button{border:0;background:none}
.qicon{width:52px;height:52px;margin:auto;background:#fff2eb;border-radius:17px;display:grid;place-items:center;font-size:23px}
.quick label{display:block;margin-top:7px;font-weight:700;font-size:12px}
.notice{margin:0 10px 14px;padding:16px;color:#657080}
.banner{margin:0 10px 14px;padding:27px;min-height:210px;border-radius:26px;background:linear-gradient(135deg,#ff4800,#ff8a00);color:#fff}
.banner h1{font-size:28px;margin:9px 0}
.banner p{line-height:1.5}
.banner button,.primary{border:0;background:#ff6500;color:#fff;border-radius:22px;padding:12px 20px;font-weight:800}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 10px}
.tile{padding:17px}
.tile b,.tile small{display:block}
.tile small{margin-top:5px;color:#788290}
.nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(720px,100%);height:78px;background:#fff;border-radius:27px 27px 0 0;box-shadow:0 -8px 25px #14223816;display:flex;align-items:center;justify-content:space-around;z-index:5}
.nav button{border:0;background:none;color:#9299a5;font-size:20px}
.nav button span{display:block;font-size:11px}
.nav .active{color:#ff6500}
.nav .go{width:62px;height:62px;border-radius:50%;background:#ff6500;color:#fff;border:5px solid #fff;margin-top:-32px}
.modal{display:none;position:fixed;inset:0;background:#0008;z-index:10;align-items:flex-end;justify-content:center}
.sheet{background:#fff;width:min(720px,100%);max-height:90vh;overflow:auto;border-radius:28px 28px 0 0;padding:24px}
.close{float:right;border:0;background:#eee;border-radius:50%;width:34px;height:34px}
.form-group{margin:14px 0}
.form-group label{display:block;font-weight:700;margin-bottom:7px}
.form-group input,.form-group select{width:100%;padding:13px;border:1px solid #ddd;border-radius:13px;font-size:15px;background:#fff}
.methods{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.method{padding:13px;border:2px solid #eee;border-radius:15px;text-align:center;cursor:pointer}
.method.selected{border-color:#ff6500;background:#fff5ef}
.number{background:#fff7f1;border-radius:14px;padding:13px;margin:10px 0}
.number b{display:block;margin-bottom:5px}
.copy{float:right;border:0;border-radius:12px;padding:6px 10px}
.hint{color:#707988;font-size:13px;line-height:1.5}
.success{display:none;background:#eaf8ef;color:#1c713c;padding:12px;border-radius:12px;margin-top:12px}
.profile{display:flex;gap:14px;align-items:center;padding:14px;background:#fff7f1;border-radius:18px;margin:12px 0}
.avatar{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:#ffe3d4;font-size:30px}
.task-grid{display:grid;gap:12px;margin:0 10px 16px}
.task-card{padding:16px;border:1px solid #f0e4dc;display:flex;align-items:center;gap:13px}
.task-icon{width:52px;height:52px;flex:0 0 52px;border-radius:16px;background:#fff1e8;display:grid;place-items:center;font-size:23px}
.task-info{flex:1}
.task-info b{display:block;margin-bottom:5px}
.task-info small{color:#7a8290}
.task-reward{font-weight:900;color:#ff6500;white-space:nowrap}
.task-btn{border:0;background:#ff6500;color:#fff;border-radius:14px;padding:9px 12px;font-weight:800;margin-top:8px}
.task-btn:disabled{background:#b9bec7}
.task-modal{display:none;position:fixed;inset:0;background:#0009;z-index:20;align-items:center;justify-content:center;padding:18px}
.task-box{background:#fff;width:min(440px,100%);border-radius:26px;padding:24px;text-align:center}
.task-progress{height:10px;background:#eee;border-radius:10px;overflow:hidden;margin:18px 0}
.task-progress>div{height:100%;width:0;background:#ff6500;transition:width 1s linear}
.countdown{font-size:46px;font-weight:900;color:#ff6500;margin:12px 0}
</style>
</head>


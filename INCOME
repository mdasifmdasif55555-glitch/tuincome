let profile = JSON.parse(localStorage.getItem("tu_profile") || "null");

let currentTask = null;
let taskTimer = null;

function openSheet(type){
  let title={
    deposit:"ডিপোজিট",
    withdraw:"উত্তোলন",
    register:"রেজিস্ট্রেশন",
    profile:"প্রোফাইল",
    wallet:"ওয়ালেট",
    refer:"রেফারেল",
    history:"লেনদেনের ইতিহাস",
    team:"টিম"
  }[type] || "TUINCOME";

  document.getElementById("sheetTitle").textContent=title;

  let b="";

  if(type==="deposit"){
    b=`
    <p class="hint">Payment করার পর Transaction ID দিয়ে request জমা দিন।</p>
    <div class="number"><b>bKash</b>01726270731</div>
    <div class="number"><b>Nagad</b>01921145861</div>
    <div class="form-group">
      <label>ডিপোজিটের পরিমাণ</label>
      <input id="depAmount" type="number" min="1" placeholder="যেমন: 500">
    </div>
    <div class="form-group">
      <label>Transaction ID</label>
      <input id="txn" placeholder="যেমন: TXN123456">
    </div>
    <button class="primary" onclick="submit('deposit')">
      Deposit Request Submit
    </button>
    <div class="success" id="success">Request saved.</div>`;
  }

  else if(type==="withdraw"){
    b=`
    <div class="number">
      <b>Minimum Withdrawal: ৳500</b>
      ৫০০ টাকার কম হলে withdrawal request গ্রহণ করা হবে না।
    </div>

    <div class="form-group">
      <label>উত্তোলনের পরিমাণ</label>
      <input id="wdAmount" type="number" min="500" placeholder="যেমন: 500">
    </div>

    <div class="form-group">
      <label>পেমেন্ট মাধ্যম</label>
      <select id="wdMethod">
        <option>bKash</option>
        <option>Nagad</option>
      </select>
    </div>

    <div class="form-group">
      <label>আপনার মোবাইল নম্বর</label>
      <input id="wdNumber" inputmode="numeric" maxlength="11" placeholder="01XXXXXXXXX">
    </div>

    <button class="primary" onclick="submit('withdraw')">
      Withdrawal Request Submit
    </button>

    <div class="success" id="success">Withdrawal request saved.</div>`;
  }

  else if(type==="register" || type==="profile"){
    b=`
    <div class="profile">
      <div class="avatar">👤</div>
      <div>
        <b>${profile?.name || "নতুন ব্যবহারকারী"}</b>
        <small style="display:block;color:#777">
          ${profile?.phone || "এখনো রেজিস্টার করা হয়নি"}
        </small>
      </div>
    </div>

    <div class="form-group">
      <label>আপনার নাম</label>
      <input id="pname" value="${profile?.name || ""}" placeholder="পুরো নাম">
    </div>

    <div class="form-group">
      <label>মোবাইল নম্বর</label>
      <input id="pphone" value="${profile?.phone || ""}" maxlength="11" placeholder="01XXXXXXXXX">
    </div>

    <button class="primary" onclick="saveProfile()">Profile Save</button>`;
  }

  else if(type==="refer"){
    b=`
    <p>আপনার referral link:</p>
    <input style="width:100%;padding:13px;border:1px solid #ddd;border-radius:13px"
      readonly value="https://tuincome-demo.example/ref/DEMOUSER">
    <button class="primary"
      onclick="copyNum('https://tuincome-demo.example/ref/DEMOUSER')">
      Copy Referral Link
    </button>`;
  }

  else if(type==="history"){
    b=`
    <p class="hint">Transaction history database-এর সাথে পরে যুক্ত করা যাবে।</p>
    <div class="number">কোনো transaction এখনো দেখানো হয়নি।</div>`;
  }

  else if(type==="team"){
    b=`
    <div class="number">
      <b>VIP প্যাকেজ</b>
